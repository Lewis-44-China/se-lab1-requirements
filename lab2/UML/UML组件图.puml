@startuml
' 实验二：活动票务与报名系统 组件图
' 实线：同步调用；虚线：只读查询或基础设施依赖。
' 为避免连线过密，横切依赖（审计/权限、通知、持久化）统一用注释说明。
skinparam componentStyle rectangle
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ArrowColor #4A5568
skinparam nodesep 35
skinparam ranksep 45
skinparam component {
  BackgroundColor #F7FAFC
  BorderColor #4A5568
}
skinparam database {
  BackgroundColor #EDF2F7
  BorderColor #4A5568
}

package "表现层" {
  [Web 前端\n（按角色显示导航）] as Web
}

package "业务模块（实验一 8 个）" {
  [M1 活动与场次\n（含审核）] as M1
  [M2 票种与容量] as M2
  [M3 报名与支付标记] as M3
  [M4 退票与候补] as M4
  [M5 检票] as M5
  [M6 查询与统计] as M6
  [M8 账号与管理员处置] as M8
}

package "横切与支撑" {
  [M7 留痕与权限] as M7
  [S1 通知] as S1
  [S2 持久化与并发\n（仓储/事务/Outbox）] as S2
}

database "MySQL 8.0" as DB

' 表现层通过应用服务接口调用
Web --> M1
Web --> M3
Web --> M5
Web --> M6
Web --> M7
Web --> M8

' 业务模块之间的同步依赖
M1 --> M2 : 场次/票种
M3 --> M2 : 原子占用名额
M3 --> M4 : 满员入队
M4 --> M2 : 释放名额
M5 --> M3 : 查询/更新报名状态
M8 --> M1 : 紧急取消
M8 --> M4 : 强制退票
M8 --> M6 : 全平台数据

' 查询模块只读
M6 ..> M1 : 只读
M6 ..> M3 : 只读
M6 ..> M5 : 只读

' 横切与持久化
M7 ..> S2
S1 ..> DB
S2 --> DB

legend bottom
  实线：同步调用；虚线：只读查询或基础设施依赖。
  所有业务模块通过 M7（审计/权限）、S1（通知）、S2（仓储/事务）协作，详见报告模块职责表。
  M3 → M4 为同步入队；M4 退票后通过 Outbox 发布 CapacityReleased 事件，
  由 M3 的递补编排器消费，避免 M4 反向编译依赖 M3。
endlegend

@enduml
